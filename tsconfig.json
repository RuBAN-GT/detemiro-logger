{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "target": "es6",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "lib": ["es2015", "dom"],
    "outDir": "./dist/",
    "sourceMap": true,
    "declaration": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "detemiro-logger": ["./libs/core/src/index.ts"],
      "detemiro-logger-node": ["./libs/node/src/index.ts"],
      "detemiro-logger-browser": ["./libs/browser/src/index.ts"],
      "detemiro-logger-nestjs": ["./libs/nestjs/src/index.ts"]
    }
  }
}
