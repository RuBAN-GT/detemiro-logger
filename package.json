{
  "name": "detemiro-logger-workspace",
  "version": "2.0.0",
  "description": "The universal logger for Detemiro projects with different adapters.",
  "private": true,
  "author": "Dmitry Ruban",
  "repository": "https://github.com/RuBAN-GT/detemiro-logger",
  "license": "ISC",
  "packageManager": "yarn@4.9.1",
  "workspaces": [
    "libs/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "lint": "yarn eslint 'libs/*/src/**/*.{ts,tsx}'",
    "lint:fix": "yarn eslint 'libs/*/src/**/*.{ts,tsx}' --fix",
    "pretty:check": "prettier --check libs",
    "pretty:fix": "prettier --write libs",
    "prepare": "husky install"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "logform": "^2.7.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/node": "^20.8.2",
    "eslint": "^9.12.0",
    "eslint-config-detemiro": "2.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-project-structure": "^3.13.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^15.11.0",
    "husky": "^8.0.3",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.8.1"
  }
}
