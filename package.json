{
  "name": "detemiro-logger-workspace",
  "version": "1.0.0",
  "description": "The generic logger helping you to log your messages.",
  "private": true,
  "author": "Dmitry Ruban",
  "license": "ISC",
  "homepage": "https://github.com/RuBAN-GT/detemiro-logger#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RuBAN-GT/detemiro-logger.git"
  },
  "packageManager": "yarn@4.5.0",
  "workspaces": [
    "libs/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "lint": "yarn eslint 'libs/*/src/**/*.{ts,tsx}'",
    "lint:fix": "yarn eslint 'libs/*/src/**/*.{ts,tsx}' --fix"
  },
  "dependencies": {
    "@colors/colors": "^1.6.0",
    "logform": "^2.6.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^20.8.2",
    "eslint": "^9.20.1",
    "eslint-config-detemiro": "^2.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "prettier": "^3.5.1",
    "tsup": "^7.2.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.24.1"
  }
}
